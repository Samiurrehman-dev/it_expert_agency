# Replace USER, PASSWORD, HOST, PORT, and DATABASE_NAME with your MySQL details.
# URL-encode special characters in USER or PASSWORD (for example, @ becomes %40).
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Create at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Cloudinary dashboard → Settings → API Keys (available after free signup).
# Keep the API secret server-side; never expose it with a NEXT_PUBLIC_ prefix.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
